{
  "name": "viral-sync-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "app",
    "clients",
    "cranks",
    "launch",
    "relayer",
    "sdk",
    "server/actions"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:program": "anchor build",
    "backup:neon": "node scripts/backup-neon-ledger.mjs",
    "monitor:production": "node scripts/check-production.mjs",
    "production:readiness": "node scripts/validate-production-readiness.mjs",
    "production:readiness:strict": "node scripts/validate-production-readiness.mjs --strict",
    "localnet:register-merchant": "ts-node scripts/register-merchant-localnet.ts",
    "localnet:causal-commerce": "ts-node scripts/run-causal-commerce-localnet.ts",
    "devnet:causal-commerce": "ts-node scripts/run-causal-commerce-localnet.ts --rpc https://api.devnet.solana.com --replay-check --attack-check --output app/public/proofs/devnet-causal-commerce.json",
    "test:anchor-attacks": "ts-node scripts/run-causal-commerce-localnet.ts --replay-check --attack-check --close-check",
    "localnet:verify-receipt": "ts-node scripts/verify-causal-receipt-localnet.ts",
    "localnet:smoke": "ts-node scripts/smoke-localnet-causal-commerce.ts",
    "localnet:proof-graph": "ts-node scripts/export-localnet-proof-graph.ts",
    "localnet:evidence-report": "ts-node scripts/write-localnet-evidence-report.ts",
    "frontier:submission": "ts-node scripts/prepare-frontier-submission.ts",
    "premium:gate": "ts-node scripts/audit-premium-redesign.ts",
    "premium:copy": "node scripts/audit-premium-copy.mjs",
    "premium:screenshots": "node scripts/capture-premium-screenshots.mjs",
    "premium:visual-gate": "node scripts/audit-premium-visuals.mjs",
    "premium:a11y": "node scripts/audit-premium-accessibility.mjs",
    "premium:performance": "node scripts/audit-premium-performance.mjs",
    "premium:release-candidate": "node scripts/prepare-premium-release-candidate.mjs",
    "premium:final": "node scripts/run-premium-final-gate.mjs",
    "seed:demo": "ts-node scripts/seed-demo.ts",
    "reset:demo": "ts-node scripts/reset-demo.ts",
    "lint": "npm run lint --workspaces --if-present",
    "test:protocol": "ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run lint --workspace app && npm run build --workspace app && npm run build --workspace viral-sync-clients && npm run build --workspace viral-sync-launch && npm run build --workspace viral-sync-sdk && npm run build --workspace relayer && npm run build --workspace cranks && npm run build --workspace viral-sync-actions && cargo check --manifest-path programs/viral_sync/Cargo.toml && npm run build:program && npm run test:protocol",
    "devnet:verify-receipt": "ts-node scripts/verify-causal-receipt-localnet.ts --manifest app/public/proofs/devnet-causal-commerce.json",
    "test:protocol:attack": "cross-env RUN_ANCHOR_ATTACK_TESTS=1 ts-mocha -p ./tsconfig.json -t 1000000 tests/anchor-attack-localnet.spec.ts",
    "frontier:verify": "npm run build:program && npm run devnet:verify-receipt -- --output tmp/devnet-causal-commerce-verifier.json && npm run frontier:submission && npm run test:protocol:attack"
  },
  "overrides": {
    "axios": "1.15.2",
    "postcss": "8.5.10",
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.5"
    }
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
