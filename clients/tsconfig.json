{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "react"]
  },
  "include": [
    "pos/src/**/*.ts",
    "pos/src/**/*.tsx",
    "web/src/**/*.ts",
    "web/src/**/*.tsx"
  ]
}
