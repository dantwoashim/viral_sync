{
  "mcp": "/.well-known/mcp.json",
  "rules": [
    {
      "pathPattern": "/api/actions/campaign/*",
      "apiPath": "/api/actions/campaign/*"
    },
    {
      "pathPattern": "/api/product-loop/claim-pass",
      "apiPath": "/api/product-loop/claim-pass"
    },
    {
      "pathPattern": "/api/product-loop/terminal/confirm",
      "apiPath": "/api/product-loop/terminal/confirm"
    },
    {
      "pathPattern": "/api/agent/receipt/*",
      "apiPath": "/api/agent/receipt/*"
    },
    {
      "pathPattern": "/api/agent/validation",
      "apiPath": "/api/agent/validation"
    },
    {
      "pathPattern": "/api/agent/readiness",
      "apiPath": "/api/agent/readiness"
    },
    {
      "pathPattern": "/api/agent/year-one",
      "apiPath": "/api/agent/year-one"
    }
  ],
  "x402": {
    "relayer": {
      "baseUrlEnv": "RELAYER_PUBLIC_URL",
      "mcp": "/.well-known/mcp.json",
      "createCampaign": "POST /campaigns/create",
      "verifyReceipt": "GET /receipts/{receiptPda}/verify"
    }
  }
}
